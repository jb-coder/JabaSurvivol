{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Migrate": false
  },
  "RateLimiting": {
    "LeaderboardSubmitPermitLimit": 30
  },
  "RemoteConfig": {
    "Version": 1,
    "MinimumClientVersion": "0.5.0",
    "MaintenanceMode": false,
    "CloudSavesEnabled": true,
    "LeaderboardsEnabled": true,
    "TelemetryEnabled": false,
    "TelemetrySampleRate": 0.0
  }
}
