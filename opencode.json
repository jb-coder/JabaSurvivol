{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "orchestrator",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git reset --hard*": "ask",
      "git push --force*": "deny"
    },
    "external_directory": "allow"
  }
}
